{
  "name": "maul-cli",
  "version": "0.2.0",
  "description": "Unofficial CLI and MCP server for Maul (máltíðir), the Icelandic workplace lunch-ordering service",
  "license": "MIT",
  "author": "Axel Paul Gunnarsson",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/axelpaul/maul-cli.git"
  },
  "homepage": "https://github.com/axelpaul/maul-cli#readme",
  "bugs": {
    "url": "https://github.com/axelpaul/maul-cli/issues"
  },
  "private": true,
  "type": "module",
  "module": "src/index.ts",
  "bin": {
    "maul": "src/index.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "start": "bun src/index.ts",
    "dev": "bun --watch src/index.ts",
    "build": "bun build --compile src/index.ts --outfile dist/maul",
    "test": "bun test",
    "lint": "biome check src/ test/",
    "lint:fix": "biome check --write src/ test/",
    "format": "biome format --write src/ test/",
    "typecheck": "tsc --noEmit",
    "check": "bun run lint && bun run typecheck && bun run test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "amazon-cognito-identity-js": "^6.3.16",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/bun": "^1.4.4",
    "typescript": "^5.9.3"
  }
}
